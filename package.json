{
  "type": "module",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1"
    }
  },
  "scripts": {
    "build": "pnpm --filter satorigear... build",
    "dev": "pnpm --filter satorigear... --parallel dev",
    "prepare": "zin link satorigear",
    "prepare:corpus": "node scripts/corpus.ts",
    "release": "bumpp -r --no-push -c \"release: v%s\"",
    "test": "vitest",
    "typecheck": "tsc -b",
    "benchmark:codspeed": "vitest bench --run",
    "benchmark:docs": "node scripts/benchmark.ts",
    "benchmark:features": "node --expose-gc test/benchmark/features.bench.ts",
    "benchmark:incremental": "node --expose-gc test/benchmark/incremental.bench.ts",
    "benchmark:parse": "node --expose-gc test/benchmark/parse.bench.ts"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "@zinkawaii/eslint-config": "catalog:",
    "@zinkawaii/scripts": "catalog:default",
    "@zinkawaii/tsconfig": "catalog:",
    "bumpp": "catalog:",
    "commonmark-spec": "catalog:",
    "eslint": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mitata": "catalog:",
    "satteri": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
