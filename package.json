{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm --filter satorigear... build",
    "dev": "pnpm --filter satorigear... --parallel dev",
    "prepare": "zin link satorigear",
    "prepare:vendor": "node scripts/vendor.ts",
    "release": "bumpp -r --no-push -c \"release: v%s\"",
    "test": "vitest",
    "typecheck": "tsc",
    "benchmark": "node --expose-gc benchmark/parse.bench.ts",
    "test:markdown": "vitest run test/markdown.test.ts",
    "conformance:markdown": "vitest run test/markdown-conformance.test.ts test/markdown-phased-conformance.test.ts test/markdown-phased-inline-conformance.test.ts test/markdown-phased-payload-conformance.test.ts test/markdown-phased-semantic-conformance.test.ts test/markdown-phased-source-ranges.test.ts test/markdown-mdast-conformance.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@types/commonmark": "catalog:",
    "@types/node": "catalog:",
    "@zinkawaii/eslint-config": "catalog:",
    "@zinkawaii/scripts": "catalog:default",
    "@zinkawaii/tsconfig": "catalog:",
    "bumpp": "catalog:",
    "commonmark": "catalog:",
    "commonmark-spec": "catalog:",
    "entities": "catalog:",
    "eslint": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdurl": "catalog:",
    "mitata": "catalog:",
    "remark": "catalog:",
    "satteri": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
