--- /dev/null
+++ b/src/cst.ts
@@ -0,0 +1,29 @@
+import type { SourceRange } from './source-view.ts';
+
+export interface CstNode {
+  rule: string;
+  children: CstChild[];
+  offset: number;
+  end: number;
+  ranges?: SourceRange[];
+}
+
+export interface CstLeaf {
+  tokenType: string;
+  offset: number;
+  end: number;
+  ranges?: SourceRange[];
+  value?: string;
+}
+
+export type CstChild = CstNode | CstLeaf;
+
+/** Read a CST span from its logical value, mapped ranges, or contiguous source range. */
+export function getText(
+  node: { offset: number; end: number; ranges?: readonly SourceRange[]; value?: string },
+  source: string,
+): string {
+  return node.value ?? (node.ranges?.length
+    ? node.ranges.map(range => source.slice(range.offset, range.end)).join('')
+    : source.slice(node.offset, node.end));
+}
