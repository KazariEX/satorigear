--- /dev/null
+++ b/src/composite-parser.ts
@@ -0,0 +1,101 @@
+import type { Token } from './gen-lexer.ts';
+import type { CstChild, CstLeaf, CstNode } from './gen-parser.ts';
+import { createSourceView, type SourceRange, type SourceView } from './source-view.ts';
+
+export interface CompositeParserHandle {
+  parse(source: string, entryRule?: string): CstNode;
+  parseTokens(source: string, tokens: readonly Token[], entryRule?: string): CstNode;
+}
+
+export interface CompositeRegion {
+  within: readonly string[];
+  contentToken: string;
+  inner: Pick<CompositeParserHandle, 'parse'>;
+  entryRule?: string;
+}
+
+export interface CompositeParserOptions {
+  outer: CompositeParserHandle;
+  outerTokens?: (source: string) => readonly Token[];
+  outerEntryRule?: string;
+  regions: readonly CompositeRegion[];
+}
+
+function rangesOf(child: CstLeaf): SourceRange[] {
+  return child.ranges?.length ? [...child.ranges] : [{ offset: child.offset, end: child.end }];
+}
+
+function rebaseSpan<T extends { offset: number; end: number; ranges?: SourceRange[] }>(
+  span: T,
+  view: SourceView,
+): Pick<T, 'offset' | 'end' | 'ranges'> {
+  const ranges = view.mapRange(span.offset, span.end);
+  const point = ranges.length ? ranges[0].offset : view.mapPoint(span.offset);
+  const end = ranges.length ? ranges[ranges.length - 1].end : point;
+  return {
+    offset: point,
+    end,
+    ...(ranges.length > 1 ? { ranges } : {}),
+  } as Pick<T, 'offset' | 'end' | 'ranges'>;
+}
+
+/** Project a CST parsed from a logical SourceView back onto the original source coordinates. */
+export function rebaseCst(node: CstNode, view: SourceView): CstNode {
+  const children: CstChild[] = node.children.map((child) => {
+    if ('tokenType' in child) return { ...child, ...rebaseSpan(child, view) };
+    return rebaseCst(child, view);
+  });
+  return { ...node, children, ...rebaseSpan(node, view) };
+}
+
+/**
+ * Compose an outer structural grammar with one or more inner grammars. Region content is declared
+ * by token type; the runner builds a SourceView, parses it with the inner Monogram parser, rebases
+ * the resulting CST, and replaces the content leaves with that CST root.
+ */
+export function createCompositeParser(options: CompositeParserOptions) {
+  const regionByRule = new Map<string, CompositeRegion>();
+  for (const region of options.regions) {
+    for (const rule of region.within) {
+      if (regionByRule.has(rule)) throw new Error(`Multiple composite regions declared for rule '${rule}'`);
+      regionByRule.set(rule, region);
+    }
+  }
+
+  function parseOuter(source: string, entryRule?: string): CstNode {
+    return options.outerTokens
+      ? options.outer.parseTokens(source, options.outerTokens(source), entryRule ?? options.outerEntryRule)
+      : options.outer.parse(source, entryRule ?? options.outerEntryRule);
+  }
+
+  function parse(source: string, entryRule?: string): CstNode {
+    const root = parseOuter(source, entryRule);
+
+    const compose = (node: CstNode): void => {
+      const region = regionByRule.get(node.rule);
+      if (region) {
+        const content = node.children.filter(
+          (child): child is CstLeaf => 'tokenType' in child && child.tokenType === region.contentToken,
+        );
+        if (content.length > 0) {
+          const view = createSourceView(source, content.flatMap(rangesOf));
+          const inner = rebaseCst(region.inner.parse(view.text, region.entryRule), view);
+          let inserted = false;
+          node.children = node.children.flatMap((child) => {
+            if (!('tokenType' in child) || child.tokenType !== region.contentToken) return [child];
+            if (inserted) return [];
+            inserted = true;
+            return [inner];
+          });
+        }
+        return;
+      }
+      for (const child of node.children) if (!('tokenType' in child)) compose(child);
+    };
+
+    compose(root);
+    return root;
+  }
+
+  return { parse, parseOuter };
+}
