+import type { Token } from './gen-lexer.ts';
+
+export interface DelimiterRunConfig {
+  token: string;
+  marker: string;
+  fallbackToken: string;
+  single: { open: string; close: string };
+  double: { open: string; close: string };
+  intraword?: boolean;
+  ruleOfThree?: boolean;
+}
+
+export interface PairedTokenConfig<State = undefined> {
+  opener: string;
+  closer: string;
+  open: string;
+  close: string;
+  deactivateEarlier?: readonly string[];
+  isolateDelimiters?: boolean;
+  content?: {
+    requireNonWhitespace?: boolean;
+    maxCharacters?: number;
+    forbidTokens?: readonly string[];
+  };
+  activate?: (context: PairedTokenActivationContext<State>) => boolean;
+  splitUnmatchedCloser?: (token: Token) => Token[];
+}
+
+export interface PairedTokenActivationContext<State = undefined> {
+  source: string;
+  tokens: readonly Token[];
+  opener: Token;
+  closer: Token;
+  content: string;
+  state: State;
+}
+
+export interface TokenIsolationRange {
+  start: number;
+  end: number;
+  id: number;
+}
+
+export interface PairedTokenResolution {
+  tokens: readonly Token[];
+  delimiterIsolations: TokenIsolationRange[];
+}
+
+export interface DelimitedTokenResolver<State> {
+  resolve: (source: string, tokens: readonly Token[], state: State) => Token[];
+}
+
+interface Run {
+  tokenIndex: number;
+  token: Token;
+  config: DelimiterRunConfig;
+  length: number;
+  remaining: number;
+  canOpen: boolean;
+  canClose: boolean;
+  active: boolean;
+  scope: string;
+}
+
+interface Replacement {
+  offset: number;
+  end: number;
+  type: string;
+}
+
+interface PairIndex<State> {
+  byCloser: ReadonlyMap<string, ReadonlyMap<string, IndexedPair<State>>>;
+  openerTypes: ReadonlySet<string>;
+  splitByCloser: ReadonlyMap<string, (token: Token) => Token[]>;
+}
+
+interface IndexedPair<State> {
+  config: PairedTokenConfig<State>;
+  deactivatedTypes: ReadonlySet<string>;
+  forbiddenTypes: ReadonlySet<string>;
+}
+
+const whitespace = /\s/u;
+const punctuation = /[\p{P}\p{S}]/u;
+
+function characterBefore(source: string, offset: number): string {
+  if (offset <= 0) return '\n';
+  const trailing = source.charCodeAt(offset - 1);
+  if (trailing >= 0xDC00 && trailing <= 0xDFFF && offset > 1) {
+    const leading = source.charCodeAt(offset - 2);
+    if (leading >= 0xD800 && leading <= 0xDBFF) return source.slice(offset - 2, offset);
+  }
+  return source[offset - 1];
+}
+
+function characterAfter(source: string, offset: number): string {
+  return offset < source.length ? String.fromCodePoint(source.codePointAt(offset)!) : '\n';
+}
+
+function flanking(source: string, token: Token, config: DelimiterRunConfig): Pick<Run, 'canOpen' | 'canClose'> {
+  const before = characterBefore(source, token.offset);
+  const after = characterAfter(source, token.offset + token.text.length);
+  const beforeWhitespace = whitespace.test(before);
+  const afterWhitespace = whitespace.test(after);
+  const beforePunctuation = punctuation.test(before);
+  const afterPunctuation = punctuation.test(after);
+  const left = !afterWhitespace && (!afterPunctuation || beforeWhitespace || beforePunctuation);
+  const right = !beforeWhitespace && (!beforePunctuation || afterWhitespace || afterPunctuation);
+  if (config.intraword !== false) return { canOpen: left, canClose: right };
+  return {
+    canOpen: left && (!right || beforePunctuation),
+    canClose: right && (!left || afterPunctuation),
+  };
+}
+
+function canPair(opener: Run, closer: Run): boolean {
+  if (opener.scope !== closer.scope) return false;
+  if (!opener.canOpen || !closer.canClose) return false;
+  if (!closer.config.ruleOfThree || (!opener.canClose && !closer.canOpen)) return true;
+  const sum = opener.remaining + closer.remaining;
+  return sum % 3 !== 0 || (opener.remaining % 3 === 0 && closer.remaining % 3 === 0);
+}
+
+/** Resolve nearest-opener token pairs and expose configured delimiter-isolation regions. */
+function indexPairs<State>(configs: readonly PairedTokenConfig<State>[]): PairIndex<State> {
+  const byCloser = new Map<string, Map<string, IndexedPair<State>>>();
+  const openerTypes = new Set<string>();
+  const splitByCloser = new Map<string, (token: Token) => Token[]>();
+  for (const config of configs) {
+    openerTypes.add(config.opener);
+    const byOpener = byCloser.get(config.closer) ?? new Map<string, IndexedPair<State>>();
+    byOpener.set(config.opener, {
+      config,
+      deactivatedTypes: new Set(config.deactivateEarlier),
+      forbiddenTypes: new Set(config.content?.forbidTokens),
+    });
+    byCloser.set(config.closer, byOpener);
+    if (config.splitUnmatchedCloser) {
+      splitByCloser.set(config.closer, config.splitUnmatchedCloser);
+    }
+  }
+  return { byCloser, openerTypes, splitByCloser };
+}
+
+function resolvePairedTokens<State>(
+  source: string,
+  tokens: readonly Token[],
+  index: PairIndex<State>,
+  state: State,
+): PairedTokenResolution {
+  const stack: { tokenIndex: number; type: string; active: boolean }[] = [];
+  const replacements = new Map<number, string>();
+  const delimiterIsolations: TokenIsolationRange[] = [];
+
+  tokens.forEach((token, tokenIndex) => {
+    if (index.openerTypes.has(token.type)) stack.push({ tokenIndex, type: token.type, active: true });
+
+    const byOpener = index.byCloser.get(token.type);
+    if (!byOpener) return;
+    let openerIndex = stack.length - 1;
+    while (openerIndex >= 0 && !byOpener.has(stack[openerIndex].type)) openerIndex--;
+    if (openerIndex < 0) return;
+
+    const opener = stack[openerIndex];
+    const indexed = byOpener.get(opener.type)!;
+    const { config } = indexed;
+    stack.splice(openerIndex, 1);
+    if (!opener.active) return;
+    const content = source.slice(tokens[opener.tokenIndex].offset + tokens[opener.tokenIndex].text.length, token.offset);
+    const contentConfig = config.content;
+    if (contentConfig?.requireNonWhitespace && !/\S/u.test(content)) return;
+    if (contentConfig?.maxCharacters !== undefined && [...content].length > contentConfig.maxCharacters) return;
+    if (indexed.forbiddenTypes.size > 0) {
+      for (let index = opener.tokenIndex + 1; index < tokenIndex; index++) {
+        if (indexed.forbiddenTypes.has(tokens[index].type)) return;
+      }
+    }
+    if (config.activate && !config.activate({
+      source,
+      tokens,
+      opener: tokens[opener.tokenIndex],
+      closer: token,
+      content,
+      state,
+    })) return;
+    replacements.set(opener.tokenIndex, config.open);
+    replacements.set(tokenIndex, config.close);
+
+    if (indexed.deactivatedTypes.size > 0) {
+      for (let index = openerIndex - 1; index >= 0; index--) {
+        if (indexed.deactivatedTypes.has(stack[index].type)) stack[index].active = false;
+      }
+    }
+
+    if (config.isolateDelimiters) {
+      delimiterIsolations.push({
+        start: tokens[opener.tokenIndex].offset + tokens[opener.tokenIndex].text.length,
+        end: token.offset,
+        id: delimiterIsolations.length,
+      });
+    }
+  });
+
+  return {
+    tokens: replacements.size === 0
+      ? tokens
+      : tokens.map((token, tokenIndex) => replacements.has(tokenIndex)
+          ? { ...token, type: replacements.get(tokenIndex)!, k: 0, t: 0 }
+          : token),
+    delimiterIsolations,
+  };
+}
+
+function replacementToken(base: Token, replacement: Replacement, first: boolean): Token {
+  return {
+    ...base,
+    type: replacement.type,
+    text: base.text.slice(replacement.offset - base.offset, replacement.end - base.offset),
+    offset: replacement.offset,
+    k: 0,
+    t: 0,
+    newlineBefore: first && base.newlineBefore,
+    commentBefore: first && base.commentBefore,
+    multilineFlowBefore: first && base.multilineFlowBefore,
+  };
+}
+
+/** Resolve flanking delimiter runs into balanced structural tokens before ordinary CST parsing. */
+function resolveDelimiterRunsWithIndex(
+  source: string,
+  tokens: readonly Token[],
+  configByToken: ReadonlyMap<string, DelimiterRunConfig>,
+  isolations: readonly TokenIsolationRange[] = [],
+): Token[] {
+  const runs: Run[] = [];
+  tokens.forEach((token, tokenIndex) => {
+    const config = configByToken.get(token.type);
+    if (!config) return;
+    const length = token.text.length / config.marker.length;
+    const scope = isolations
+      .filter(isolation => token.offset >= isolation.start && token.offset < isolation.end)
+      .map(isolation => isolation.id)
+      .join(',');
+    runs.push({ tokenIndex, token, config, length, remaining: length, active: true, scope, ...flanking(source, token, config) });
+  });
+
+  const replacements = new Map<number, Replacement[]>();
+  for (let closerIndex = 0; closerIndex < runs.length; closerIndex++) {
+    const closer = runs[closerIndex];
+    while (closer.active && closer.canClose && closer.remaining > 0) {
+      let openerIndex = closerIndex - 1;
+      while (openerIndex >= 0) {
+        const candidate = runs[openerIndex];
+        if (candidate.active && candidate.config === closer.config && candidate.remaining > 0 && canPair(candidate, closer)) break;
+        openerIndex--;
+      }
+      if (openerIndex < 0) break;
+      const opener = runs[openerIndex];
+      const use = opener.remaining >= 2 && closer.remaining >= 2 ? 2 : 1;
+      const openEnd = opener.token.offset + opener.remaining * opener.config.marker.length;
+      const openStart = openEnd - use * opener.config.marker.length;
+      const closeStart = closer.token.offset + (closer.length - closer.remaining) * closer.config.marker.length;
+      const closeEnd = closeStart + use * closer.config.marker.length;
+      const pair = use === 2 ? closer.config.double : closer.config.single;
+      const openerReplacements = replacements.get(opener.tokenIndex) ?? [];
+      openerReplacements.push({ offset: openStart, end: openEnd, type: pair.open });
+      replacements.set(opener.tokenIndex, openerReplacements);
+      const closerReplacements = replacements.get(closer.tokenIndex) ?? [];
+      closerReplacements.push({ offset: closeStart, end: closeEnd, type: pair.close });
+      replacements.set(closer.tokenIndex, closerReplacements);
+      opener.remaining -= use;
+      closer.remaining -= use;
+      for (let between = openerIndex + 1; between < closerIndex; between++) runs[between].active = false;
+    }
+  }
+
+  return tokens.flatMap((token, tokenIndex) => {
+    const config = configByToken.get(token.type);
+    if (!config) return [token];
+    const matched = (replacements.get(tokenIndex) ?? []).sort((a, b) => a.offset - b.offset);
+    const fragments: Replacement[] = [];
+    let offset = token.offset;
+    for (const replacement of matched) {
+      if (replacement.offset > offset) fragments.push({ offset, end: replacement.offset, type: config.fallbackToken });
+      fragments.push(replacement);
+      offset = replacement.end;
+    }
+    const end = token.offset + token.text.length;
+    if (offset < end) fragments.push({ offset, end, type: config.fallbackToken });
+    return fragments.map((replacement, index) => replacementToken(token, replacement, index === 0));
+  });
+}
+
+export function createDelimitedTokenResolver<State = undefined>(
+  delimiterConfigs: readonly DelimiterRunConfig[],
+  pairConfigs: readonly PairedTokenConfig<State>[] = [],
+): DelimitedTokenResolver<State> {
+  const delimiterByToken = new Map(delimiterConfigs.map(config => [config.token, config]));
+  const pairIndex = indexPairs(pairConfigs);
+  const resolve = (source: string, tokens: readonly Token[], state: State): Token[] => {
+    let paired = resolvePairedTokens(source, tokens, pairIndex, state);
+    let expanded: Token[] | undefined;
+    for (let tokenIndex = 0; tokenIndex < tokens.length; tokenIndex++) {
+      const token = tokens[tokenIndex];
+      const split = pairIndex.splitByCloser.get(token.type);
+      const fragments = split && paired.tokens[tokenIndex].type === token.type ? split(token) : undefined;
+      if (fragments) {
+        expanded ??= tokens.slice(0, tokenIndex);
+        expanded.push(...fragments);
+      }
+      else {
+        expanded?.push(token);
+      }
+    }
+    if (expanded) {
+      paired = resolvePairedTokens(source, expanded, pairIndex, state);
+    }
+    return resolveDelimiterRunsWithIndex(source, paired.tokens, delimiterByToken, paired.delimiterIsolations);
+  };
+  return { resolve };
+}
